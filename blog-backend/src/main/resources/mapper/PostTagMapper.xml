<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cpphub.blog.mapper.PostTagMapper">

    <select id="selectTagsByPostIds" resultType="java.util.Map">
        SELECT pt.post_id AS post_id, t.name AS name
        FROM post_tag pt
        INNER JOIN tag t ON t.id = pt.tag_id
        WHERE pt.post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        ORDER BY pt.post_id, t.name
    </select>
</mapper>